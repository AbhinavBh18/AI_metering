# Copy to .env. Blank Stripe values allow all non-payment features to run.
# Local development credentials only; replace for shared/deployed databases.
DATABASE_URL=postgresql://metering:metering_local@127.0.0.1:5432/metering
TEST_DATABASE_URL=postgresql://metering:metering_local@127.0.0.1:5432/metering_test
# Docker Compose database credentials (local development only).
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering_local
POSTGRES_DB=metering
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
# Test mode only. Never paste keys into source control or evidence.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A test-mode USD recurring monthly price of $19.00, created in Stripe.
STRIPE_PRO_PRICE_ID=
